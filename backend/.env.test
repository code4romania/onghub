# Complete environment for the e2e suite (npm run test:e2e), loaded by
# test/setup-env.ts. backend/.env is NOT used by tests: any key that exists
# there but not here is blanked, so a test can never reach a remote database,
# Cognito, S3 or SES. Nothing secret here; signing keys are generated per run.
NODE_ENV=local
PORT=3001
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=pass123
# test/utils/test-data-source.ts appends the Jest worker id: onghub_test_<n>
DATABASE_TEST_NAME=onghub_test
TYPEORM_DEBUG=0
# The harness migrates from src (test/utils/test-data-source.ts); never from a stale dist.
TYPEORM_MIGRATIONS_RUN=false
THROTTLE_TTL=60
THROTTLE_LIMIT=1000
REDIS_HOST=localhost
REDIS_PORT=6379
CACHE_TTL=1
BULL_PREFIX=test-ngohub
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=test
MAIL_PASS=test
MAIL_FROM=no-reply@ngohub.test
MAIL_CONTACT=contact@ngohub.test
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_S3_BUCKET_NAME=ngohub-test
AWS_S3_BUCKET_NAME_PUBLIC=ngohub-test-public
ONGHUB_URL=https://app.ngohub.test
WEB_APP_URL=https://app.ngohub.test
CORS_ORIGINS=https://app.ngohub.test
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS_WEB=7
# JWT_PRIVATE_KEY / JWT_PUBLIC_KEY / AUTH_TOKEN_KEY are generated per run (test/utils/auth-test-config.ts)
